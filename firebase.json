{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": [
    {
      "database": "dainyel-content",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "target": "production",
      "public": ".",
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/admin.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/studio",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/data/trip.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/admin.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "private/**",
        "**/.*",
        "**/node_modules/**",
        "AGENTS.md",
        "PROJECT_HANDOFF.md",
        "README.md",
        "tools/**"
      ],
      "redirects": [
        {
          "source": "/about.html",
          "destination": "/?view=about",
          "type": 301
        },
        {
          "source": "/videos.html",
          "destination": "/?view=films",
          "type": 301
        },
        {
          "source": "/destinations.html",
          "destination": "/?view=map",
          "type": 301
        },
        {
          "source": "/journey.html",
          "destination": "/?view=trip",
          "type": 301
        },
        {
          "source": "/qa.html",
          "destination": "/?view=ask",
          "type": 301
        },
        {
          "source": "/my-kit.html",
          "destination": "/?view=kit",
          "type": 301
        },
        {
          "source": "/collaborate.html",
          "destination": "/?view=collaborate",
          "type": 301
        },
        {
          "source": "/blog.html",
          "destination": "/stories.html",
          "type": 301
        },
        {
          "source": "/updates.html",
          "destination": "/stories.html#field-notes",
          "type": 301
        }
      ]
    },
    {
      "target": "staging",
      "public": ".",
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive, noimageindex"
            }
          ]
        },
        {
          "source": "/admin.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/studio",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/data/trip.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/admin.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "private/**",
        "**/.*",
        "**/node_modules/**",
        "AGENTS.md",
        "PROJECT_HANDOFF.md",
        "README.md",
        "tools/**"
      ],
      "redirects": [
        {
          "source": "/about.html",
          "destination": "/?view=about",
          "type": 301
        },
        {
          "source": "/videos.html",
          "destination": "/?view=films",
          "type": 301
        },
        {
          "source": "/destinations.html",
          "destination": "/?view=map",
          "type": 301
        },
        {
          "source": "/journey.html",
          "destination": "/?view=trip",
          "type": 301
        },
        {
          "source": "/qa.html",
          "destination": "/?view=ask",
          "type": 301
        },
        {
          "source": "/my-kit.html",
          "destination": "/?view=kit",
          "type": 301
        },
        {
          "source": "/collaborate.html",
          "destination": "/?view=collaborate",
          "type": 301
        },
        {
          "source": "/blog.html",
          "destination": "/stories.html",
          "type": 301
        },
        {
          "source": "/updates.html",
          "destination": "/stories.html#field-notes",
          "type": 301
        }
      ]
    }
  ]
}
