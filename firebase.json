{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": [
    {
      "database": "dainyel-content",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "target": "production",
      "public": ".",
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/data/trip.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "regex": "^/[^./]+/?$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "regex": "^/(admin(\\.html)?|studio)/?$",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/admin.html"
        },
        {
          "source": "/entry/**",
          "destination": "/entry.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "private/**",
        "**/.*",
        "**/.*/**",
        ".github/**",
        ".git/**",
        ".firebase/**",
        ".devcontainer/**",
        "**/node_modules/**",
        "AGENTS.md",
        "PROJECT_HANDOFF.md",
        "README.md",
        "tools/**"
      ],
      "redirects": [
        {
          "source": "/index.html",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/index",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/index/",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/destinations.html",
          "destination": "/atlas",
          "type": 301
        },
        {
          "source": "/destinations",
          "destination": "/atlas",
          "type": 301
        },
        {
          "source": "/destinations/",
          "destination": "/atlas",
          "type": 301
        },
        {
          "source": "/blog.html",
          "destination": "/stories",
          "type": 301
        },
        {
          "source": "/blog",
          "destination": "/stories",
          "type": 301
        },
        {
          "source": "/blog/",
          "destination": "/stories",
          "type": 301
        },
        {
          "source": "/updates.html",
          "destination": "/field-notes",
          "type": 301
        },
        {
          "source": "/updates",
          "destination": "/field-notes",
          "type": 301
        },
        {
          "source": "/updates/",
          "destination": "/field-notes",
          "type": 301
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "target": "staging",
      "public": ".",
      "headers": [
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive, noimageindex"
            }
          ]
        },
        {
          "source": "/data/trip.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "regex": "^/[^./]+/?$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "regex": "^/(admin(\\.html)?|studio)/?$",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/admin.html"
        },
        {
          "source": "/entry/**",
          "destination": "/entry.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "private/**",
        "**/.*",
        "**/.*/**",
        ".github/**",
        ".git/**",
        ".firebase/**",
        ".devcontainer/**",
        "**/node_modules/**",
        "AGENTS.md",
        "PROJECT_HANDOFF.md",
        "README.md",
        "tools/**"
      ],
      "redirects": [
        {
          "source": "/index.html",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/index",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/index/",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/destinations.html",
          "destination": "/atlas",
          "type": 301
        },
        {
          "source": "/destinations",
          "destination": "/atlas",
          "type": 301
        },
        {
          "source": "/destinations/",
          "destination": "/atlas",
          "type": 301
        },
        {
          "source": "/blog.html",
          "destination": "/stories",
          "type": 301
        },
        {
          "source": "/blog",
          "destination": "/stories",
          "type": 301
        },
        {
          "source": "/blog/",
          "destination": "/stories",
          "type": 301
        },
        {
          "source": "/updates.html",
          "destination": "/field-notes",
          "type": 301
        },
        {
          "source": "/updates",
          "destination": "/field-notes",
          "type": 301
        },
        {
          "source": "/updates/",
          "destination": "/field-notes",
          "type": 301
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    }
  ]
}
