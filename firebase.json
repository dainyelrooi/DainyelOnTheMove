{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": [
    {
      "database": "dainyel-content",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "community-moderation",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "production",
      "public": ".",
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/admin.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/studio",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/admin.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "functions/**",
        "private/**",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "staging",
      "public": ".",
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive, noimageindex"
            }
          ]
        },
        {
          "source": "/admin.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/studio",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/studio",
          "destination": "/admin.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "firestore.indexes.json",
        "functions/**",
        "private/**",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
