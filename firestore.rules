rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model: /questions/{autoId} stores topic, question, optional displayName,
    // consent, status, and server createdAt; owner moderation may add answer,
    // answeredAt, and updatedAt. No email or other contact details are collected.
    // Public reads are limited to published entries; pending entries are owner-only.
    // Threat review: unverified or other accounts cannot moderate, arbitrary fields
    // are rejected, public writes must be pending and consented, and all other paths
    // are denied below. Re-review before adding collections or changing publication.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'dainyelr@gmail.com'
        && request.auth.token.email_verified == true
        // Require the Auth service's signed proof, never a browser "trusted" flag.
        && request.auth.token.firebase.get('sign_in_second_factor', '') == 'totp';
    }

    function isValidQuestion(data) {
      return data.keys().hasAll([
          'topic', 'question', 'publicationConsent', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'displayName', 'topic', 'question', 'publicationConsent', 'status',
          'createdAt', 'answer', 'answeredAt', 'updatedAt'
        ])
        && data.topic is string
        && data.topic in [
          'thailand-exchange', 'thailand-solo', 'bali', 'philippines',
          'another-destination', 'culture', 'video-gear',
          'life-on-the-move', 'something-else'
        ]
        && data.question is string
        && data.question.size() >= 10
        && data.question.size() <= 1000
        && data.publicationConsent == true
        && data.status in ['pending', 'published', 'rejected']
        && data.createdAt is timestamp
        && (!('displayName' in data)
          || (data.displayName is string && data.displayName.size() <= 40))
        && (!('answer' in data)
          || (data.answer is string && data.answer.size() <= 3000))
        && (!('answeredAt' in data) || data.answeredAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (data.status != 'published'
          || (('answer' in data) && data.answer.size() > 0
            && ('answeredAt' in data)));
    }

    function isAllowedAdminTransition() {
      return (resource.data.status == 'pending'
          && request.resource.data.status in ['published', 'rejected'])
        || (resource.data.status == 'published'
          && request.resource.data.status == 'published')
        || (resource.data.status == 'rejected'
          && request.resource.data.status == 'rejected');
    }

    match /questions/{questionId} {
      // Visitors may read only approved Q&A entries.
      allow get, list: if isOwner() || resource.data.status == 'published';

      // Public submissions enter the private moderation queue only.
      allow create: if isValidQuestion(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'displayName', 'topic', 'question', 'publicationConsent',
          'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Only the verified site owner may review or answer a submission.
      allow update: if isOwner()
        && isValidQuestion(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'answer', 'answeredAt', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && isAllowedAdminTransition()
        && (request.resource.data.status != 'published'
          || request.resource.data.answeredAt == request.time);

      allow delete: if isOwner();
    }

    // Community Q&A uses a separate collection. A visitor can submit a
    // question or reply under a nickname, but every item starts in the private
    // moderation queue. Only approved threads and replies can be read publicly.
    function isValidCommunityThread(data) {
      return data.keys().hasAll([
          'displayName', 'topic', 'question', 'publicationConsent', 'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'displayName', 'topic', 'question', 'publicationConsent', 'status',
          'createdAt', 'publishedAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.topic is string
        && data.topic in [
          'thailand', 'bali', 'philippines', 'solo-travel', 'budget',
          'culture', 'video-gear', 'general'
        ]
        && data.question is string
        && data.question.size() >= 10
        && data.question.size() <= 1000
        && data.publicationConsent == true
        && data.status in ['pending', 'published', 'rejected']
        && data.createdAt is timestamp
        && (!('publishedAt' in data) || data.publishedAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (data.status != 'published' || ('publishedAt' in data));
    }

    function isValidCommunityReply(data) {
      return data.keys().hasAll([
          'displayName', 'message', 'publicationConsent', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'displayName', 'message', 'publicationConsent', 'status',
          'createdAt', 'publishedAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 1000
        && data.publicationConsent == true
        && data.status in ['pending', 'published', 'rejected']
        && data.createdAt is timestamp
        && (!('publishedAt' in data) || data.publishedAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (data.status != 'published' || ('publishedAt' in data));
    }

    function communityThreadIsPublished(threadId) {
      return exists(/databases/$(database)/documents/communityThreads/$(threadId))
        && get(/databases/$(database)/documents/communityThreads/$(threadId)).data.status == 'published';
    }

    match /communityThreads/{threadId} {
      allow get, list: if isOwner() || resource.data.status == 'published';

      allow create: if isValidCommunityThread(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'displayName', 'topic', 'question', 'publicationConsent', 'status',
          'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner()
        && isValidCommunityThread(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.topic == resource.data.topic
        && request.resource.data.question == resource.data.question
        && request.resource.data.publicationConsent == resource.data.publicationConsent
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'publishedAt', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status != 'published'
          || request.resource.data.publishedAt == request.time);

      allow delete: if isOwner();

      match /replies/{replyId} {
        allow get, list: if isOwner()
          || (communityThreadIsPublished(threadId)
            && resource.data.status == 'published');

        allow create: if communityThreadIsPublished(threadId)
          && isValidCommunityReply(request.resource.data)
          && request.resource.data.keys().hasOnly([
            'displayName', 'message', 'publicationConsent', 'status',
            'createdAt'
          ])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner()
          && isValidCommunityReply(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.message == resource.data.message
          && request.resource.data.publicationConsent == resource.data.publicationConsent
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'publishedAt', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status != 'published'
            || request.resource.data.publishedAt == request.time);

        allow delete: if isOwner();
      }
    }

    // The moderation queue uses collectionGroup('replies') across community
    // threads. Collection-group queries need an explicit recursive match.
    // Only the verified owner may list pending replies; this grants no writes
    // or public access. Keep 'replies' reserved for community conversations.
    match /{path=**}/replies/{replyId} {
      allow list: if isOwner() && resource.data.status == 'pending';
    }

    // One public status document, managed only by the verified owner.
    match /siteStatus/current {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['city', 'country', 'updatedAt'])
        && request.resource.data.keys().hasAll(['city', 'country', 'updatedAt'])
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 60
        && request.resource.data.country is string
        && request.resource.data.country.size() > 0
        && request.resource.data.country.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }


    // Visitors may opt into occasional Field Notes emails. The subscription is
    // private: only the verified owner can read or manage the list.
    function isValidFieldNotesSubscription(data) {
      return data.keys().hasAll(['email', 'subscriptionConsent', 'status', 'createdAt'])
        && data.keys().hasOnly(['email', 'subscriptionConsent', 'status', 'createdAt'])
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.subscriptionConsent == true
        && data.status == 'subscribed'
        && data.createdAt is timestamp;
    }

    match /fieldNotes/{subscriberId} {
      allow create: if isValidFieldNotesSubscription(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isOwner();
    }

    // Private content planning only. No route, caption, image or planning state
    // is readable by visitors or by other/unverified accounts.
    function isValidCalendarPost(data) {
      return data.keys().hasAll([
          'version', 'title', 'caption', 'publishAt', 'timezone', 'imageUrl',
          'designUrl', 'musicTitle', 'musicArtist', 'musicNote', 'musicSearch',
          'musicUrl', 'scheduled', 'published', 'remindersEnabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'version', 'title', 'caption', 'publishAt', 'timezone', 'imageUrl',
          'designUrl', 'musicTitle', 'musicArtist', 'musicNote', 'musicSearch',
          'musicUrl', 'scheduled', 'published', 'remindersEnabled', 'createdAt', 'updatedAt', 'platforms'
        ])
        && (!('platforms' in data) || calendarPlatforms(data.platforms))
        && data.version == 1
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.caption is string && data.caption.size() > 0 && data.caption.size() <= 5000
        && data.publishAt is timestamp
        && data.publishAt >= timestamp.date(2020, 1, 1)
        && data.publishAt < timestamp.date(2101, 1, 1)
        && data.timezone == 'Europe/Amsterdam'
        && data.imageUrl is string && data.imageUrl.size() <= 1200
        && (data.imageUrl == '' || data.imageUrl.matches('^https://static[.]metricool[.]com/planner/[^\\s]+$'))
        && data.designUrl is string && data.designUrl.size() <= 1200
        && (data.designUrl == '' || data.designUrl.matches('^https://www[.]canva[.]com/(folder|design)/[^\\s]+$'))
        && data.musicTitle is string && data.musicTitle.size() <= 160
        && data.musicArtist is string && data.musicArtist.size() <= 160
        && data.musicNote is string && data.musicNote.size() <= 800
        && data.musicSearch is string && data.musicSearch.size() <= 500
        && data.musicUrl is string && data.musicUrl.size() <= 1200
        && (data.musicUrl == '' || data.musicUrl.matches('^https://(open[.]spotify[.]com|music[.]apple[.]com|www[.]youtube[.]com|youtube[.]com|youtu[.]be|www[.]top40[.]nl)/[^\\s]+$'))
        && data.scheduled is bool && data.published is bool
        && data.remindersEnabled is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /contentCalendar/{postId} {
      allow get, list: if isOwner();
      allow create: if isOwner() && postId.matches('^plan-[a-f0-9]{32}$')
        && isValidCalendarPost(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner() && isValidCalendarPost(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function isValidStagingCalendarPost(data) {
      return data.keys().hasAll([
          'version', 'title', 'caption', 'publishAt', 'timezone', 'imageUrl',
          'designUrl', 'musicTitle', 'musicArtist', 'musicNote', 'musicSearch',
          'musicUrl', 'scheduled', 'published', 'remindersEnabled', 'createdAt', 'updatedAt', 'platforms'
        ])
        && data.keys().hasOnly([
          'version', 'title', 'caption', 'publishAt', 'timezone', 'imageUrl',
          'designUrl', 'musicTitle', 'musicArtist', 'musicNote', 'musicSearch',
          'musicUrl', 'scheduled', 'published', 'remindersEnabled', 'createdAt', 'updatedAt', 'platforms'
        ])
        && calendarPlatforms(data.platforms)
        && data.version == 1
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.caption is string && data.caption.size() > 0 && data.caption.size() <= 5000
        && data.publishAt is timestamp
        && data.publishAt >= timestamp.date(2020, 1, 1)
        && data.publishAt < timestamp.date(2101, 1, 1)
        && data.timezone == 'Europe/Amsterdam'
        && data.imageUrl is string && data.imageUrl.size() <= 1200
        && (data.imageUrl == '' || data.imageUrl.matches('^https://static[.]metricool[.]com/planner/[^\\s]+$'))
        && data.designUrl is string && data.designUrl.size() <= 1200
        && (data.designUrl == '' || data.designUrl.matches('^https://www[.]canva[.]com/(folder|design)/[^\\s]+$'))
        && data.musicTitle is string && data.musicTitle.size() <= 160
        && data.musicArtist is string && data.musicArtist.size() <= 160
        && data.musicNote is string && data.musicNote.size() <= 800
        && data.musicSearch is string && data.musicSearch.size() <= 500
        && data.musicUrl is string && data.musicUrl.size() <= 1200
        && (data.musicUrl == '' || data.musicUrl.matches('^https://(open[.]spotify[.]com|music[.]apple[.]com|www[.]youtube[.]com|youtube[.]com|youtu[.]be|www[.]top40[.]nl)/[^\\s]+$'))
        && data.scheduled is bool && data.published is bool
        && data.remindersEnabled is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    // The redesigned calendar is isolated on staging. Legacy production
    // planning/reminder preferences are deliberately untouched.
    function calendarPlatforms(values) {
      return values is list && values.size() >= 1 && values.size() <= 6
        && values.toSet().size() == values.size()
        && values.hasOnly(['instagram','youtube','tiktok','facebook','linkedin','pinterest']);
    }
    match /calendarSpaces/{space}/posts/{postId} {
      allow get: if space == 'staging' && isOwner();
      allow list: if space == 'staging' && isOwner() && request.query.limit <= 200;
      allow create: if space == 'staging' && isOwner() && postId.matches('^plan-[a-f0-9]{32}$')
        && isValidStagingCalendarPost(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if space == 'staging' && isOwner() && isValidStagingCalendarPost(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /adminOperations/{space}/status/{id} {
      allow get: if space in ['staging','production'] && isOwner() && id in ['backup','release'];
      allow list, write: if false;
    }

    function isValidCalendarReminder(data) {
      return data.keys().hasAll(['version', 'enabled', 'timezone', 'localHour', 'updatedAt'])
        && data.keys().hasOnly(['version', 'enabled', 'timezone', 'localHour', 'updatedAt'])
        && data.version == 1 && data.enabled is bool
        && data.timezone == 'Europe/Amsterdam' && data.localHour == 9
        && data.updatedAt == request.time;
    }

    match /contentCalendarSettings/reminders {
      allow get: if isOwner();
      allow create, update: if isOwner() && isValidCalendarReminder(request.resource.data);
      allow list, delete: if false;
    }
    // Delivery state is written only by the existing IAM worker; no mail key
    // or private outbox is available to the browser.
    match /contentCalendarSettings/delivery {
      allow get: if isOwner();
      allow list, write: if false;
    }


    // Self-service website content. The approved release opens staging and production.
    // Drafts stay private; publishing copies a strict whitelist into published.
    function cmsSpace(space) { return space in ['staging','production']; }
    function cmsId(id) { return id is string && id.matches('^entry-[a-f0-9]{32}$'); }
    function cmsPhotoId(id) { return id is string && id.matches('^photo-[a-f0-9]{32}$'); }
    function cmsPhotos(ids) {
      return ids is list && ids.size() <= 12 && ids.toSet().size() == ids.size()
        && (ids.size() <= 0 || cmsPhotoId(ids[0]))
        && (ids.size() <= 1 || cmsPhotoId(ids[1]))
        && (ids.size() <= 2 || cmsPhotoId(ids[2]))
        && (ids.size() <= 3 || cmsPhotoId(ids[3]))
        && (ids.size() <= 4 || cmsPhotoId(ids[4]))
        && (ids.size() <= 5 || cmsPhotoId(ids[5]))
        && (ids.size() <= 6 || cmsPhotoId(ids[6]))
        && (ids.size() <= 7 || cmsPhotoId(ids[7]))
        && (ids.size() <= 8 || cmsPhotoId(ids[8]))
        && (ids.size() <= 9 || cmsPhotoId(ids[9]))
        && (ids.size() <= 10 || cmsPhotoId(ids[10]))
        && (ids.size() <= 11 || cmsPhotoId(ids[11]))
        ;
    }
    // Optional editorial fields keep existing entries/backups readable. New
    // writes include all fields. A photo position is -1 (cover only), 0
    // (opening) or a chapter number 1..24, parallel to the bounded photo IDs.
    function cmsPlacement(value) { return value is int && value >= -1 && value <= 24; }
    function cmsPlacements(ids, positions) {
      return positions is list && positions.size() == ids.size()
        && (positions.size() <= 0 || cmsPlacement(positions[0]))
        && (positions.size() <= 1 || cmsPlacement(positions[1]))
        && (positions.size() <= 2 || cmsPlacement(positions[2]))
        && (positions.size() <= 3 || cmsPlacement(positions[3]))
        && (positions.size() <= 4 || cmsPlacement(positions[4]))
        && (positions.size() <= 5 || cmsPlacement(positions[5]))
        && (positions.size() <= 6 || cmsPlacement(positions[6]))
        && (positions.size() <= 7 || cmsPlacement(positions[7]))
        && (positions.size() <= 8 || cmsPlacement(positions[8]))
        && (positions.size() <= 9 || cmsPlacement(positions[9]))
        && (positions.size() <= 10 || cmsPlacement(positions[10]))
        && (positions.size() <= 11 || cmsPlacement(positions[11]));
    }
    function cmsPresentation(data) {
      return data.get('heroLayout','split') in ['split','wide']
        && data.get('heroPosition','center') in ['top','center','bottom']
        && data.get('heroPhotoId','') is string
        && (data.get('heroPhotoId','') == '' || data.heroPhotoId in data.photoIds)
        && data.get('storyLabel','') is string && data.get('storyLabel','').size() <= 120
        && data.get('tripPeriod','') is string && data.get('tripPeriod','').size() <= 80
        && (!('photoPlacements' in data) || cmsPlacements(data.photoIds,data.photoPlacements));
    }
    function cmsContent(data, complete) {
      return data.version == 1 && data.kind in ['blog', 'field-note', 'fact']
        && data.title is string && (!complete || data.title.size() > 0) && data.title.size() <= 140
        && data.excerpt is string && (!complete || data.excerpt.size() >= 10) && data.excerpt.size() <= 320
        && data.body is string && (!complete || data.body.size() >= 10) && data.body.size() <= 60000
        && data.place is string && data.place.size() <= 100
        && data.sources is string && data.sources.size() <= 3000
        && data.videoUrl is string && data.videoUrl.size() <= 500
        && (!complete || data.videoUrl == '' || data.videoUrl.matches('^https://(www[.])?(youtube[.]com|youtu[.]be|vimeo[.]com)/[^ ]+$'))
        && cmsPhotos(data.photoIds) && cmsPresentation(data) && data.updatedAt == request.time;
    }
    function validCmsDraft(data) {
      return data.keys().hasAll(['version','kind','title','excerpt','body','place','sources','videoUrl','photoIds','revision','createdAt','updatedAt'])
        && data.keys().hasOnly(['version','kind','title','excerpt','body','place','sources','videoUrl','photoIds','revision','createdAt','updatedAt','heroPhotoId','heroLayout','heroPosition','storyLabel','tripPeriod','photoPlacements'])
        && cmsContent(data, false) && data.revision is int && data.revision > 0 && data.revision <= 1000000
        && data.createdAt is timestamp;
    }
    function validCmsPublished(data, space, entryId) {
      let draft = getAfter(/databases/$(database)/documents/cmsSpaces/$(space)/drafts/$(entryId)).data;
      return data.keys().hasAll(['version','kind','title','excerpt','body','place','sources','videoUrl','photoIds','publishedAt','updatedAt'])
        && data.keys().hasOnly(['version','kind','title','excerpt','body','place','sources','videoUrl','photoIds','publishedAt','updatedAt','heroPhotoId','heroLayout','heroPosition','storyLabel','tripPeriod','photoPlacements'])
        && cmsContent(data, true) && data.publishedAt is timestamp
        // Exact content equality in one bounded map comparison. Repeating every
        // optional field exhausted the expression budget for twelve-photo posts.
        // Only draft/publication metadata may differ; no content field is exempt.
        && data.diff(draft).affectedKeys().hasOnly(['revision','createdAt','publishedAt','updatedAt']);
    }
    function validCmsPhoto(data) {
      return data.keys().hasAll(['version','entryId','dataUrl','alt','width','height','createdAt'])
        && data.keys().hasOnly(['version','entryId','dataUrl','alt','width','height','createdAt'])
        && data.version == 1 && cmsId(data.entryId)
        && data.dataUrl is string && data.dataUrl.size() <= 192000
        && data.dataUrl.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')
        && data.alt is string && data.alt.size() > 0 && data.alt.size() <= 180
        && data.width is int && data.width > 0 && data.width <= 1600
        && data.height is int && data.height > 0 && data.height <= 1600
        && data.createdAt == request.time;
    }
    function validCmsSummary(data, space, entryId) {
      let post = getAfter(/databases/$(database)/documents/cmsSpaces/$(space)/published/$(entryId)).data;
      return data.keys().hasAll(['version','kind','title','excerpt','place','coverPhotoId','publishedAt','updatedAt'])
        && data.keys().hasOnly(['version','kind','title','excerpt','place','coverPhotoId','publishedAt','updatedAt'])
        && data.version == 1 && data.kind == post.kind && data.title == post.title
        && data.excerpt == post.excerpt && data.place == post.place
        && data.coverPhotoId == (post.photoIds.size() > 0 ? post.photoIds[0] : '')
        && data.publishedAt == post.publishedAt && data.updatedAt == request.time;
    }
    // Immutable private recovery snapshots. Exact parent equality also
    // bounds the embedded map and prevents arbitrary data in the archive.
    function recoveryCopy(data,parent,revisionId) {
      return data.keys().hasAll(['version','content','savedAt'])
        && data.keys().hasOnly(['version','content','savedAt'])
        && data.version == 1 && data.content is map
        && data.content.revision is int && data.content.revision > 0 && data.content.revision <= 1000000
        && revisionId == 'r' + string(data.content.revision)
        && data.savedAt == request.time
        && (data.content == getAfter(parent).data
          || (exists(parent) && data.content == get(parent).data));
    }
    function hasRecovery(family,space,kind,id,data) {
      let revisionId = 'r' + string(data.revision);
      return getAfter(/databases/$(database)/documents/$(family)/$(space)/$(kind)/$(id)/history/$(revisionId)).data.content == data;
    }

    match /cmsSpaces/{space}/drafts/{entryId} {
      allow get: if cmsSpace(space) && isOwner();
      allow list: if cmsSpace(space) && isOwner() && request.query.limit <= 100;
      allow create: if cmsSpace(space) && isOwner() && cmsId(entryId) && validCmsDraft(request.resource.data)
        && hasRecovery('cmsSpaces',space,'drafts',entryId,request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if cmsSpace(space) && isOwner() && cmsId(entryId) && validCmsDraft(request.resource.data)
        && hasRecovery('cmsSpaces',space,'drafts',entryId,request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /cmsSpaces/{space}/drafts/{entryId}/history/{revisionId} {
      allow get: if cmsSpace(space) && isOwner();
      allow list: if cmsSpace(space) && isOwner() && request.query.limit <= 20;
      allow create: if cmsSpace(space) && isOwner() && cmsId(entryId)
        && recoveryCopy(request.resource.data,/databases/$(database)/documents/cmsSpaces/$(space)/drafts/$(entryId),revisionId);
      allow update, delete: if false;
    }
    match /cmsSpaces/{space}/published/{entryId} {
      allow get: if cmsSpace(space);
      allow list: if cmsSpace(space) && request.query.limit <= 100;
      allow create: if cmsSpace(space) && isOwner() && cmsId(entryId)
        && validCmsPublished(request.resource.data,space,entryId) && request.resource.data.publishedAt == request.time;
      allow update: if cmsSpace(space) && isOwner() && cmsId(entryId)
        && validCmsPublished(request.resource.data,space,entryId) && request.resource.data.publishedAt == resource.data.publishedAt;
      allow delete: if cmsSpace(space) && isOwner();
    }
    match /cmsSpaces/{space}/media/{photoId} {
      allow get: if cmsSpace(space) && (isOwner() || (exists(/databases/$(database)/documents/cmsSpaces/$(space)/published/$(resource.data.entryId))
        && photoId in get(/databases/$(database)/documents/cmsSpaces/$(space)/published/$(resource.data.entryId)).data.photoIds));
      allow list: if false;
      allow create: if cmsSpace(space) && isOwner() && cmsPhotoId(photoId) && validCmsPhoto(request.resource.data);
      // An edited photo gets a new ID, keeping published media unchanged in drafts.
      allow update, delete: if false;
    }
    // Archive cards fetch only short summaries, never full article bodies.
    match /cmsSpaces/{space}/summaries/{entryId} {
      allow get: if cmsSpace(space);
      allow list: if cmsSpace(space) && request.query.limit <= 100;
      allow create, update: if cmsSpace(space) && isOwner() && cmsId(entryId)
        && validCmsSummary(request.resource.data,space,entryId);
      allow delete: if cmsSpace(space) && isOwner()
        && !existsAfter(/databases/$(database)/documents/cmsSpaces/$(space)/published/$(entryId));
    }

    // Existing-page edits: private per-section drafts, explicit public snapshots,
    // and immutable WebP media. Each section has <=24 bounded string fields.
    // Staging and production are isolated; public snapshots exclude owner/security data.
    function websiteSpace(space) { return space in ['staging','production']; }
    function websiteId(id) { return id is string && id.size() <= 90 && id.matches('^[a-z][a-z0-9-]*-[a-f0-9]{16}$'); }
    function websitePage(id) { return id is string && id.size() <= 71 && (id in ['index','about','stories','videos','collaborate','my-kit','atlas','qa','thailand','thailand-solo','bali','philippines','shared'] || id.matches('^note-[a-z0-9-]+$')); }
    function websiteValues(values) {
      return values is map && values.size() <= 24
        && values.keys().hasOnly(['f00', 'f01', 'f02', 'f03', 'f04', 'f05', 'f06', 'f07', 'f08', 'f09', 'f10', 'f11', 'f12', 'f13', 'f14', 'f15', 'f16', 'f17', 'f18', 'f19', 'f20', 'f21', 'f22', 'f23'])
        && (!('f00' in values) || (values.f00 is string && values.f00.size() <= 8000))
        && (!('f01' in values) || (values.f01 is string && values.f01.size() <= 8000))
        && (!('f02' in values) || (values.f02 is string && values.f02.size() <= 8000))
        && (!('f03' in values) || (values.f03 is string && values.f03.size() <= 8000))
        && (!('f04' in values) || (values.f04 is string && values.f04.size() <= 8000))
        && (!('f05' in values) || (values.f05 is string && values.f05.size() <= 8000))
        && (!('f06' in values) || (values.f06 is string && values.f06.size() <= 8000))
        && (!('f07' in values) || (values.f07 is string && values.f07.size() <= 8000))
        && (!('f08' in values) || (values.f08 is string && values.f08.size() <= 8000))
        && (!('f09' in values) || (values.f09 is string && values.f09.size() <= 8000))
        && (!('f10' in values) || (values.f10 is string && values.f10.size() <= 8000))
        && (!('f11' in values) || (values.f11 is string && values.f11.size() <= 8000))
        && (!('f12' in values) || (values.f12 is string && values.f12.size() <= 8000))
        && (!('f13' in values) || (values.f13 is string && values.f13.size() <= 8000))
        && (!('f14' in values) || (values.f14 is string && values.f14.size() <= 8000))
        && (!('f15' in values) || (values.f15 is string && values.f15.size() <= 8000))
        && (!('f16' in values) || (values.f16 is string && values.f16.size() <= 8000))
        && (!('f17' in values) || (values.f17 is string && values.f17.size() <= 8000))
        && (!('f18' in values) || (values.f18 is string && values.f18.size() <= 8000))
        && (!('f19' in values) || (values.f19 is string && values.f19.size() <= 8000))
        && (!('f20' in values) || (values.f20 is string && values.f20.size() <= 8000))
        && (!('f21' in values) || (values.f21 is string && values.f21.size() <= 8000))
        && (!('f22' in values) || (values.f22 is string && values.f22.size() <= 8000))
        && (!('f23' in values) || (values.f23 is string && values.f23.size() <= 8000));
    }
    function validWebsiteSection(data,id) {
      return data.version == 1 && websitePage(data.pageId) && id.matches('^' + data.pageId + '-[a-f0-9]{16}$')
        && websiteValues(data.values) && cmsPhotos(data.photoIds)
        && data.revision is int && data.revision > 0 && data.revision <= 1000000 && data.updatedAt == request.time;
    }
    function validWebsiteDraft(data,id) {
      return data.keys().hasAll(['version','pageId','values','photoIds','revision','createdAt','updatedAt'])
        && data.keys().hasOnly(['version','pageId','values','photoIds','revision','createdAt','updatedAt'])
        && validWebsiteSection(data,id) && data.createdAt is timestamp;
    }
    function validWebsitePublication(data,space,id) {
      let draft = getAfter(/databases/$(database)/documents/websiteSpaces/$(space)/drafts/$(id)).data;
      return data.keys().hasAll(['version','pageId','values','photoIds','revision','publishedAt','updatedAt'])
        && data.keys().hasOnly(['version','pageId','values','photoIds','revision','publishedAt','updatedAt'])
        && validWebsiteSection(data,id) && data.publishedAt is timestamp
        && data.pageId == draft.pageId && data.values == draft.values && data.photoIds == draft.photoIds
        && data.revision == draft.revision && draft.updatedAt == request.time;
    }
    function validWebsitePhoto(data) {
      return data.keys().hasAll(['version','sectionId','dataUrl','alt','width','height','createdAt'])
        && data.keys().hasOnly(['version','sectionId','dataUrl','alt','width','height','createdAt'])
        && data.version == 1 && websiteId(data.sectionId)
        && data.dataUrl is string && data.dataUrl.size() <= 192000 && data.dataUrl.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')
        && data.alt is string && data.alt.size() > 0 && data.alt.size() <= 180
        && data.width is int && data.width > 0 && data.width <= 1600 && data.height is int && data.height > 0 && data.height <= 1600
        && data.createdAt == request.time;
    }
    match /websiteSpaces/{space}/drafts/{id} {
      allow get: if websiteSpace(space) && isOwner();
      allow create: if websiteSpace(space) && isOwner() && websiteId(id) && validWebsiteDraft(request.resource.data,id)
        && hasRecovery('websiteSpaces',space,'drafts',id,request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if websiteSpace(space) && isOwner() && websiteId(id) && validWebsiteDraft(request.resource.data,id)
        && request.resource.data.pageId == resource.data.pageId && hasRecovery('websiteSpaces',space,'drafts',id,request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow list: if websiteSpace(space) && isOwner() && request.query.limit <= 100;
      allow delete: if false;
    }
    match /websiteSpaces/{space}/drafts/{id}/history/{revisionId} {
      allow get: if websiteSpace(space) && isOwner();
      allow list: if websiteSpace(space) && isOwner() && request.query.limit <= 20;
      allow create: if websiteSpace(space) && isOwner() && websiteId(id)
        && recoveryCopy(request.resource.data,/databases/$(database)/documents/websiteSpaces/$(space)/drafts/$(id),revisionId);
      allow update, delete: if false;
    }
    match /websiteSpaces/{space}/published/{id} {
      allow get: if websiteSpace(space);
      allow list: if websiteSpace(space) && request.query.limit <= 100;
      allow create: if websiteSpace(space) && isOwner() && websiteId(id) && validWebsitePublication(request.resource.data,space,id)
        && request.resource.data.publishedAt == request.time;
      allow update: if websiteSpace(space) && isOwner() && websiteId(id) && validWebsitePublication(request.resource.data,space,id)
        && request.resource.data.pageId == resource.data.pageId && request.resource.data.publishedAt == resource.data.publishedAt;
      allow delete: if websiteSpace(space) && isOwner();
    }
    match /websiteSpaces/{space}/media/{id} {
      allow get: if websiteSpace(space) && (isOwner() || (exists(/databases/$(database)/documents/websiteSpaces/$(space)/published/$(resource.data.sectionId))
        && id in get(/databases/$(database)/documents/websiteSpaces/$(space)/published/$(resource.data.sectionId)).data.photoIds));
      allow create: if websiteSpace(space) && isOwner() && cmsPhotoId(id) && validWebsitePhoto(request.resource.data);
      allow list, update, delete: if false;
    }
    // Bounded plain-text search supplements; no image data or private drafts.
    function validWebsiteSearch(data,space,id) {
      let post = getAfter(/databases/$(database)/documents/websiteSpaces/$(space)/published/$(id)).data;
      return data.keys().hasAll(['version','pageId','text','updatedAt']) && data.keys().hasOnly(['version','pageId','text','updatedAt'])
        && data.version == 1 && websitePage(data.pageId) && data.pageId == post.pageId
        && data.text is string && data.text.size() <= 12000 && data.updatedAt == request.time && post.updatedAt == request.time;
    }
    match /websiteSpaces/{space}/search/{id} {
      allow get: if websiteSpace(space);
      allow list: if websiteSpace(space) && request.query.limit <= 100;
      allow create, update: if websiteSpace(space) && isOwner() && websiteId(id) && validWebsiteSearch(request.resource.data,space,id);
      allow delete: if websiteSpace(space) && isOwner() && !existsAfter(/databases/$(database)/documents/websiteSpaces/$(space)/published/$(id));
    }

    // Private Postcard drafts and immutable delivery snapshots. No subscriber
    // addresses or provider credential is available to the browser. Delivery
    // settings/results are written only by the existing IAM worker.
    function cmsMailId(id) { return id is string && id.matches('^mail-[a-f0-9]{32}$'); }
    function mailContent(data, complete) {
      return data.keys().hasAll(['subject','previewText','headline','body','ctaText','ctaUrl','imageUrl'])
        && data.subject is string && data.subject.size() <= 140 && (!complete || data.subject.size() > 0)
        && data.previewText is string && data.previewText.size() <= 200
        && data.headline is string && data.headline.size() <= 160 && (!complete || data.headline.size() > 0)
        && data.body is string && data.body.size() <= 12000 && (!complete || data.body.size() >= 10)
        && data.ctaText is string && data.ctaText.size() <= 80 && (!complete || data.ctaText.size() > 0)
        && data.ctaUrl is string && data.ctaUrl.size() <= 250
        && (!complete || (data.ctaUrl.matches('^https://dainyelonthemove[.]com/(entry/entry-[a-f0-9]{32}|[a-z0-9-]*)$')
          && !data.ctaUrl.matches('^https://dainyelonthemove[.]com/(admin|studio|search|postcards-form)$')))
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && (data.imageUrl == '' || data.imageUrl.matches('^https://dainyelonthemove[.]com/assets/[a-zA-Z0-9/_-]+[.](webp|jpg|jpeg|png)$'));
    }
    function validMailDraft(data) {
      return data.keys().hasOnly(['version','subject','previewText','headline','body','ctaText','ctaUrl','imageUrl','revision','createdAt','updatedAt'])
        && data.keys().hasAll(['version','revision','createdAt','updatedAt']) && data.version == 1
        && mailContent(data,false) && data.revision is int && data.revision > 0 && data.revision <= 1000000
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validMailRequest(data, space, id) {
      let draft = get(/databases/$(database)/documents/cmsSpaces/$(space)/mailDrafts/$(id)).data;
      return data.keys().hasAll(['version','draftId','draftRevision','payload','action','scheduledAt','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['version','draftId','draftRevision','payload','action','scheduledAt','status','createdAt','updatedAt'])
        && data.version == 1 && data.draftId == id && data.draftRevision == draft.revision
        && data.payload is map && data.payload.keys().hasOnly(['subject','previewText','headline','body','ctaText','ctaUrl','imageUrl'])
        && mailContent(data.payload,true)
        && data.payload.subject == draft.subject && data.payload.previewText == draft.previewText
        && data.payload.headline == draft.headline && data.payload.body == draft.body
        && data.payload.ctaText == draft.ctaText && data.payload.ctaUrl == draft.ctaUrl && data.payload.imageUrl == draft.imageUrl
        && data.status == 'queued' && data.createdAt == request.time && data.updatedAt == request.time
        && data.scheduledAt is timestamp
        && ((data.action == 'send' && data.scheduledAt == request.time)
          || (data.action == 'schedule' && data.scheduledAt >= request.time + duration.value(60,'m')
            && data.scheduledAt <= request.time + duration.value(90,'d')));
    }
    match /cmsSpaces/{space}/mailDrafts/{mailId} {
      allow get: if cmsSpace(space) && isOwner();
      allow list: if cmsSpace(space) && isOwner() && request.query.limit <= 50;
      allow create: if cmsSpace(space) && isOwner() && cmsMailId(mailId) && validMailDraft(request.resource.data)
        && request.resource.data.revision == 1 && hasRecovery('cmsSpaces',space,'mailDrafts',mailId,request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if cmsSpace(space) && isOwner() && cmsMailId(mailId) && validMailDraft(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && hasRecovery('cmsSpaces',space,'mailDrafts',mailId,request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /cmsSpaces/{space}/mailDrafts/{mailId}/history/{revisionId} {
      allow get: if cmsSpace(space) && isOwner();
      allow list: if cmsSpace(space) && isOwner() && request.query.limit <= 20;
      allow create: if cmsSpace(space) && isOwner() && cmsMailId(mailId)
        && recoveryCopy(request.resource.data,/databases/$(database)/documents/cmsSpaces/$(space)/mailDrafts/$(mailId),revisionId);
      allow update, delete: if false;
    }
    match /cmsSpaces/{space}/mailJobs/{mailId} {
      allow get: if cmsSpace(space) && isOwner();
      allow list, delete: if false;
      // Test-host sends are forbidden even if someone changes client code.
      allow create: if cmsSpace(space) && space == 'production' && isOwner() && cmsMailId(mailId)
        && get(/databases/$(database)/documents/cmsSpaces/$(space)/mailSettings/delivery).data.enabled == true
        && validMailRequest(request.resource.data,space,mailId);
      allow update: if cmsSpace(space) && isOwner() && resource.data.status == 'queued'
        && request.resource.data.status == 'cancelled' && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
    }
    match /cmsSpaces/{space}/mailSettings/delivery {
      allow get: if cmsSpace(space) && isOwner();
      allow list, write: if false;
    }

    // Private contact form: isolated namespaces, fixed owner inbox, no public PII reads.
    // Public limit document contains timestamps/count and an opaque request ID only.
    function contactSpace(space) { return space in ['staging','production']; }
    function validContact(data) {
      return data.keys().hasAll(['schemaVersion','name','email','topic','brand','timing','budget','message','consent','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['schemaVersion','name','email','topic','brand','timing','budget','message','consent','status','createdAt','updatedAt'])
        && data.schemaVersion == 1 && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.email is string && data.email.size() <= 254 && data.email.matches('^[^\\s@<>]+@[^\\s@<>]+[.][A-Za-z]{2,}$')
        && data.topic in ['collaboration','photography','travel-question','website-feedback','privacy','other']
        && data.brand is string && data.brand.size() <= 120 && data.timing is string && data.timing.size() <= 120
        && data.budget is string && data.budget.size() <= 80 && data.message is string && data.message.size() >= 10 && data.message.size() <= 5000
        && data.consent == true && data.status in ['queued','processing','accepted','held','closed']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validContactGate(data) {
      return data.keys().hasAll(['count','windowStart','updatedAt','lastRequest']) && data.keys().hasOnly(['count','windowStart','updatedAt','lastRequest'])
        && data.count is int && data.count >= 1 && data.count <= 20 && data.windowStart is timestamp
        && data.updatedAt == request.time && data.lastRequest is string && data.lastRequest.matches('^[a-f0-9]{32}$');
    }
    match /contactSpaces/{space}/messages/{messageId} {
      allow get: if contactSpace(space) && isOwner();
      allow list: if contactSpace(space) && isOwner() && request.query.limit <= 100;
      allow create: if contactSpace(space) && messageId.matches('^[a-f0-9]{32}$') && validContact(request.resource.data)
        && request.resource.data.status == 'queued' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/contactSpaces/$(space)/limits/submission).data.lastRequest == messageId
        && getAfter(/databases/$(database)/documents/contactSpaces/$(space)/limits/submission).data.updatedAt == request.time;
      allow update: if contactSpace(space) && isOwner() && validContact(request.resource.data)
        && request.resource.data.status == 'closed' && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if contactSpace(space) && isOwner();
    }
    match /contactSpaces/{space}/limits/submission {
      allow get: if contactSpace(space);
      allow list, delete: if false;
      allow create: if contactSpace(space) && validContactGate(request.resource.data) && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time
        && getAfter(/databases/$(database)/documents/contactSpaces/$(space)/messages/$(request.resource.data.lastRequest)).data.createdAt == request.time;
      allow update: if contactSpace(space) && validContactGate(request.resource.data)
        && request.time >= resource.data.updatedAt + duration.value(20,'s')
        && ((request.time >= resource.data.windowStart + duration.value(24,'h') && request.resource.data.count == 1 && request.resource.data.windowStart == request.time)
          || (request.time < resource.data.windowStart + duration.value(24,'h') && request.resource.data.windowStart == resource.data.windowStart && request.resource.data.count == resource.data.count + 1))
        && getAfter(/databases/$(database)/documents/contactSpaces/$(space)/messages/$(request.resource.data.lastRequest)).data.createdAt == request.time;
    }

    // Every path not listed above stays closed, including automation outboxes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
